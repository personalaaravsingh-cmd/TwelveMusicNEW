# Twelve Music — Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
SUPPORT_LINK=https://discord.com
NODE_ENV=production

# PostgreSQL / Redis (required by the Twelve Music persistence layer)
POSTGRES_URL=postgres://postgres:password@localhost:5432/ahh_twelve-music
REDIS_URL=redis://localhost:6379

# Lavalink — same node used by Vyne
LAVALINK_NODE_NAME=TripleN
LAVALINK_HOST=lavalink.nazha.online
LAVALINK_PORT=443
LAVALINK_AUTH=your_lavalink_password
LAVALINK_SECURE=true

# Web / integrations
WEBHOOK_PORT=6969
TOPGG_WEBHOOK_SECRET=unused
PREMIUM_WEBHOOK_SECRET=unused
backupWebhook=https://example.com/webhook
VOTE_ENABLED=false
