# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
SUPPORT_LINK=https://discord.com/invite/Ez4gCJQDxB
NODE_ENV=production

# Database & Cache
# Local / direct connections:
POSTGRES_URL=postgres://postgres:password@localhost:5432/eleven
REDIS_URL=redis://localhost:6379

# Docker Compose credentials (if running via Docker):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=eleven
REDIS_PASSWORD=password

# Lavalink Node Configuration
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_AUTH=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NODE_NAME=Main

# Webhook & Server Configuration
WEBHOOK_PORT=6969
TOPGG_WEBHOOK_SECRET=your_topgg_webhook_secret
PREMIUM_WEBHOOK_SECRET=your_premium_webhook_secret
backupWebhook=https://discord.com/api/webhooks/...
VOTE_ENABLED=false
